{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": ["tests/stubs/server-only.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "ignoreDependencies": ["postcss-load-config", "tailwindcss"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "tests/stubs/expo-secure-store.ts"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "tests/**/*.ts"]
    },
    "apps/pipeline": {
      "entry": ["src/commands/*.ts"],
      "project": ["**/*.ts"],
      "ignore": ["tests/fixtures/dispatch/**"]
    },
    "packages/shared": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "ignoreBinaries": ["pdftotext", "pdftoppm", "pdfinfo"]
}
