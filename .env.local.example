# Copy this file to .env.local at the repo root (not inside apps/web or
# apps/pipeline). apps/web/next.config.ts and apps/pipeline/src/lib/env.ts both
# load it from there explicitly.

# Course identity. Required on Vercel (builds and deployments) and on any production
# server; packages/shared/src/course.ts falls back to "French II" / "French II Practice &
# Assessment" only for local development, tests and local builds. Server-side
# only (no NEXT_PUBLIC_ prefix): the app title and header read them on the
# server, rather than shipping them in the client bundle. Switching
# this deployment to a new course means changing these two values.
COURSE_NAME="French II"
COURSE_TITLE="French II Practice & Assessment"

# OpenRouter API Key (required — routes all model calls: generation, validation, audit, evaluation)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_secret_api_key
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# Project ref that pipeline commands are allowed to write to (the subdomain
# in NEXT_PUBLIC_SUPABASE_URL, e.g. "abcdefghijklmnopqrst" from
# https://abcdefghijklmnopqrst.supabase.co). See apps/pipeline/README.md's
# "Supabase target guard" section. Set it only for the test project; leave it
# empty for production so every production write needs --yes-production.
EXPECTED_SUPABASE_REF=

# ADMIN_PASSWORD must be at least 16 characters; ADMIN_SESSION_SECRET and STUDENT_SESSION_SECRET at least 32 bytes
ADMIN_PASSWORD=your_secure_password
ADMIN_SESSION_SECRET=random_hex_string_for_cookie_signing

# Student session cookie signing (required — students cannot authenticate without it)
STUDENT_SESSION_SECRET=random_hex_string_for_cookie_signing

# Durable rate limiter (Upstash Redis via the Vercel Marketplace integration).
# The integration typically sets KV_REST_API_URL/KV_REST_API_TOKEN; some
# setups instead provide UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN.
# Either pair works. Without one configured, the app falls back to an
# in-memory limiter locally/in tests, and fails closed (denies requests) in
# production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (optional). When both are set, verify-code's
# circuit breaker challenges suspected scanners with Turnstile instead of a
# fixed delay. Leave both empty to use the delay-only fallback.
#
# Production: the real widget's site key and secret. The widget's approved
# hostnames in the Cloudflare dashboard must be kept in sync with the
# allowlist in apps/web/src/lib/turnstile.ts.
#
# Both Turnstile keys are required in production; without them study-code verification answers 503
# Preview and Development: Cloudflare's published test keys, since
# per-deployment preview hostnames can't be listed on the widget:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Feature Flags (set to 'true' to enable)
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=false
NEXT_PUBLIC_ENABLE_LEITNER=true