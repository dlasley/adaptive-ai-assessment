# Copy to apps/mobile/.env.local. Every EXPO_PUBLIC_ value is inlined into the app bundle and is
# public; never put a secret here.

# Origin of the web deployment the app calls. Unset in development means http://localhost:3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Origin header to send, when it must differ from the base URL's origin (a physical device
# reaching next dev at the Mac's LAN address still has to present http://localhost:3000).
# EXPO_PUBLIC_API_ORIGIN=http://localhost:3000
